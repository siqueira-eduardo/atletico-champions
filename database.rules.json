{
  "rules": {
    ".read": true,
    ".write": false,
    "admins": {
      "$uid": {
        ".write": false
      }
    },
    "resultados": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "gols": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "assistencias": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "mvps": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "sumulas": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "historicoSumulas": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "fotos": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "votacoes": {
      "$jogo": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "votos": {
          "$cpfHash": {
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
          }
        }
      }
    }
  }
}
